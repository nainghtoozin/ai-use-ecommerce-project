APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# For production (Railway, etc), set APP_URL to your HTTPS domain:
# APP_URL=https://your-domain.up.railway.app

DEV_MODE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

IDENTITY_USE_ACCOUNTS=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
# Cloudinary - required for production (Railway)
# Get your CLOUDINARY_URL from: https://console.cloudinary.com/settings
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Local: FILESYSTEM_DISK=public. For production (Railway), set to "cloudinary"
# and configure the CLOUDINARY_* variables below.
FILESYSTEM_DISK=public
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
QUEUE_CONNECTION=database

# Merchant backup archive signing (REQUIRED for /admin/backups downloads).
# The endpoint fails closed (HTTP 503) when the key is missing or shorter than 32 chars.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# Never reuse APP_KEY and never commit the real value.
MERCHANT_BACKUP_SIGNING_KEY=
MERCHANT_BACKUP_SIGNING_KEY_ID=merchant-backup-v1
MERCHANT_BACKUP_PER_HOUR=10
MERCHANT_BACKUP_VERIFY_PER_HOUR=5
MERCHANT_BACKUP_RECOVER_PER_HOUR=3
MERCHANT_BACKUP_RECOVERY_LOCK_SECONDS=300
MERCHANT_BACKUP_TEMP_TTL_HOURS=2
MERCHANT_BACKUP_UPLOAD_TTL_HOURS=1
MERCHANT_BACKUP_MAX_UPLOAD_KB=51200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 / Cloudflare R2 / DigitalOcean Spaces - required for production on Railway
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram settings configured via Admin > Settings > Telegram Bot (stored in DB)
